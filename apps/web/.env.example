# ---- PinFlow Studio web app (apps/web) ----
# Public base URL, used in verification / reset links. Also decides Secure cookies in production.
APP_URL=http://localhost:3000

# Database. Default: embedded PGlite stored in PGLITE_DIR (default apps/web/.pglite-data).
# Set DATABASE_URL to a postgres:// URL to use a real PostgreSQL server instead (same migrations).
# DATABASE_URL=postgres://pinflow:pinflow@localhost:5432/pinflow
# PGLITE_DIR=./.pglite-data

# Compile worker (apps/compile-worker). Server-side only — never exposed to the browser.
# Without it, Compile reports "Compile unavailable" instead of faking a result.
# COMPILE_WORKER_URL=http://localhost:4100
# COMPILE_WORKER_TOKEN=change-me

# Mail. No SMTP transport is implemented yet: mail goes to the dev outbox (/dev/outbox),
# which is enabled automatically outside production, or in production with PINFLOW_DEV_OUTBOX=1.
# PINFLOW_DEV_OUTBOX=1

# Cookies: force Secure on/off (default: Secure in production when APP_URL is https).
# COOKIE_SECURE=0
